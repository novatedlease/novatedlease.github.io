---
import Base from './Base.astro';

interface Props {
  title?: string;
  titleOverride?: string;
  description?: string;
  extraSchemas?: object[];
  noindex?: boolean;
}

const { title, titleOverride, description, extraSchemas, noindex } = Astro.props;
---

<Base title={title} titleOverride={titleOverride} description={description} extraSchemas={extraSchemas} noindex={noindex}>
  <slot />
</Base>
