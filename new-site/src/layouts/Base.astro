---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  articleMeta?: { title: string; description?: string; datePublished?: string; dateModified?: string };
  extraSchemas?: object[];
  noindex?: boolean;
}

const {
  title,
  description = 'Independent, evidence-based guide and calculator for understanding novated leases in Australia, including EV and ICE comparisons, tax effects, risks, and net financial outcomes.',
  ogImage = 'https://novatedlease.guide/assets/images/og-default.png',
  ogType = 'website',
  canonicalUrl,
  articleMeta,
  extraSchemas = [],
  noindex = false,
} = Astro.props;

const siteTitle = 'Novated Lease Guide & Calculator';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const currentPath = Astro.url.pathname;
const siteUrl = 'https://novatedlease.guide';
const fullCanonical = canonicalUrl || `${siteUrl}${currentPath}`;

// Canonical Person entity — referenced by Article author and ProfilePage mainEntity
const authorPerson = {
  '@type': 'Person',
  '@id': `${siteUrl}/about/about-me/#person`,
  name: 'changyang1230',
  url: `${siteUrl}/about/about-me/`,
  jobTitle: 'Anaesthetist, biostatistician, and novated lease consumer advocate',
  description: 'Australian anaesthetist, qualified biostatistician, and former mathematical olympiad national representative. Independent author of novatedlease.guide — a free evidence-based guide and calculator for understanding novated leases in Australia.',
  knowsAbout: [
    'Novated leasing',
    'Salary packaging',
    'Fringe Benefits Tax',
    'Electric vehicle FBT exemption',
    'Australian personal finance',
    'Australian tax',
    'Biostatistics',
    'Probability and statistics',
  ],
  sameAs: [
    'https://www.reddit.com/user/changyang1230',
    'https://buymeacoffee.com/changyang1230',
  ],
};

// Canonical Organization entity — referenced by Article publisher
const publisherOrg = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#org`,
  name: 'Novated Lease Guide',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/assets/images/logo.png`,
  },
  founder: { '@id': `${siteUrl}/about/about-me/#person` },
};

// JSON-LD: WebSite schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: siteTitle,
  url: siteUrl,
  description: 'Independent, evidence-based guide and calculator for understanding novated leases in Australia.',
  publisher: { '@id': `${siteUrl}/#org` },
};

// JSON-LD: BreadcrumbList — built from URL path, page title used for final crumb
const pathSegments = currentPath.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const breadcrumbItems = [{ name: 'Home', url: `${siteUrl}/` }];
if (pathSegments.length > 0) {
  let cumulative = '';
  pathSegments.forEach((seg, i) => {
    cumulative += '/' + seg;
    const isLast = i === pathSegments.length - 1;
    const label = isLast && title
      ? title
      : seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    breadcrumbItems.push({ name: label, url: `${siteUrl}${cumulative}/` });
  });
}
// JSON-LD: Article schema (article pages only)
const articleSchema = articleMeta ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleMeta.title,
  description: articleMeta.description || description,
  url: fullCanonical,
  image: ogImage,
  author: authorPerson,
  publisher: publisherOrg,
  isPartOf: { '@id': `${siteUrl}/#website` },
  mainEntityOfPage: fullCanonical,
  ...(articleMeta.datePublished ? { datePublished: articleMeta.datePublished } : {}),
  ...(articleMeta.dateModified ? { dateModified: articleMeta.dateModified } : {}),
} : null;

// JSON-LD: ProfilePage for /about/about-me/ — exposes full author entity to Google
const isAuthorPage = currentPath === '/about/about-me/' || currentPath === '/about/about-me';
const profilePageSchema = isAuthorPage ? {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: `${siteUrl}/about/about-me/`,
  mainEntity: authorPerson,
} : null;

const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
    {profilePageSchema && <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />}
    {extraSchemas.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-52RWVTCGLP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-52RWVTCGLP', { anonymize_ip: true });
    </script>
  </head>
  <body>
    <NavBar currentPath={currentPath} data-pagefind-ignore />
    <SearchModal />

    <div data-pagefind-body>
      <slot />
    </div>

    <Footer data-pagefind-ignore />

    <!-- GA4 link tracking & search keyboard shortcut -->
    <script is:inline>
      // Track Buy Me a Coffee & Tesla referral link clicks
      (function() {
        function fireGa4(name, params) {
          try { if (typeof gtag === 'function') gtag('event', name, params); } catch(e) {}
        }
        function trackLinks() {
          document.querySelectorAll('a[href^="https://buymeacoffee.com/"],a[href^="https://www.buymeacoffee.com/"],a[href^="https://ts.la/"]').forEach(function(a) {
            a.addEventListener('click', function() {
              var href = a.getAttribute('href') || '';
              fireGa4('support_link_click', {
                link_label: href.includes('buymeacoffee') ? 'buymeacoffee' : 'tesla_referral',
                link_url: href,
                page_path: window.location.pathname,
                page_title: document.title
              });
            }, { capture: true });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', trackLinks);
        } else {
          trackLinks();
        }
      })();

      // Keyboard shortcut: / or Ctrl+K to open search
      document.addEventListener('keydown', function(e) {
        if ((e.key === '/' || (e.ctrlKey && e.key === 'k') || (e.metaKey && e.key === 'k')) && !e.target.matches('input,textarea')) {
          e.preventDefault();
          window.openSearch && window.openSearch();
        }
        if (e.key === 'Escape') {
          window.closeSearch && window.closeSearch();
          window.closeDrawer && window.closeDrawer();
        }
      });
    </script>
  </body>
</html>
