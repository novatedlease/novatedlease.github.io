---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Independent, evidence-based guide and calculator for understanding novated leases in Australia, including EV and ICE comparisons, tax effects, risks, and net financial outcomes.',
  ogImage = 'https://novatedlease.guide/assets/images/og-default.png',
  canonicalUrl,
} = Astro.props;

const siteTitle = 'Novated Lease Guide & Calculator';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const currentPath = Astro.url.pathname;
const fullCanonical = canonicalUrl || `https://novatedlease.guide${currentPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/images/logo.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-52RWVTCGLP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-52RWVTCGLP', { anonymize_ip: true });
    </script>
  </head>
  <body>
    <NavBar currentPath={currentPath} data-pagefind-ignore />
    <SearchModal />

    <div data-pagefind-body>
      <slot />
    </div>

    <Footer data-pagefind-ignore />

    <!-- GA4 link tracking & search keyboard shortcut -->
    <script is:inline>
      // Track Buy Me a Coffee & Tesla referral link clicks
      (function() {
        function fireGa4(name, params) {
          try { if (typeof gtag === 'function') gtag('event', name, params); } catch(e) {}
        }
        function trackLinks() {
          document.querySelectorAll('a[href^="https://buymeacoffee.com/"],a[href^="https://www.buymeacoffee.com/"],a[href^="https://ts.la/"]').forEach(function(a) {
            a.addEventListener('click', function() {
              var href = a.getAttribute('href') || '';
              fireGa4('support_link_click', {
                link_label: href.includes('buymeacoffee') ? 'buymeacoffee' : 'tesla_referral',
                link_url: href,
                page_path: window.location.pathname,
                page_title: document.title
              });
            }, { capture: true });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', trackLinks);
        } else {
          trackLinks();
        }
      })();

      // Keyboard shortcut: / or Ctrl+K to open search
      document.addEventListener('keydown', function(e) {
        if ((e.key === '/' || (e.ctrlKey && e.key === 'k') || (e.metaKey && e.key === 'k')) && !e.target.matches('input,textarea')) {
          e.preventDefault();
          window.openSearch && window.openSearch();
        }
        if (e.key === 'Escape') {
          window.closeSearch && window.closeSearch();
          window.closeDrawer && window.closeDrawer();
        }
      });
    </script>
  </body>
</html>
