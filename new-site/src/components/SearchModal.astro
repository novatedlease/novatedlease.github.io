---
---

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-modal">
    <div id="search-container">
      <div style="padding: 16px 20px; border-bottom: 1px solid var(--color-border); display: flex; align-items: center; gap: 12px;">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex-shrink:0; opacity:0.5;">
          <circle cx="6.5" cy="6.5" r="4.5"/>
          <path d="M10 10l3 3" stroke-linecap="round"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Search articles…"
          autocomplete="off"
          spellcheck="false"
          style="flex:1; border:none; outline:none; font-size:1rem; font-family:inherit; background:transparent; color:var(--color-text);"
          aria-label="Search"
        />
        <button onclick="window.closeSearch()" aria-label="Close search" style="background:none;border:none;cursor:pointer;padding:4px;color:var(--color-text-muted);font-size:0.78rem;display:flex;align-items:center;gap:4px;">
          <kbd style="background:var(--color-bg);border:1px solid var(--color-border);border-radius:4px;padding:2px 6px;font-family:inherit;font-size:0.7rem;">Esc</kbd>
        </button>
      </div>
      <div id="search-results" class="search-results-wrap"></div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var overlay = document.getElementById('search-overlay');
    var input = document.getElementById('search-input');
    var resultsEl = document.getElementById('search-results');
    var pagefind = null;
    var searchTimeout = null;

    window.openSearch = function() {
      overlay.classList.add('open');
      setTimeout(function() { input && input.focus(); }, 50);
      initPagefind();
    };

    window.closeSearch = function() {
      overlay.classList.remove('open');
      if (input) { input.value = ''; }
      if (resultsEl) { resultsEl.innerHTML = ''; }
    };

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) window.closeSearch();
    });

    async function initPagefind() {
      if (pagefind) return;
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.options({ excerptLength: 20 });
      } catch(e) {
        resultsEl.innerHTML = '<div class="search-no-results">Search index is being built. Run <code>npm run build</code> first to enable search.</div>';
        pagefind = null;
      }
    }

    async function doSearch(query) {
      if (!pagefind || !query.trim()) {
        resultsEl.innerHTML = '';
        return;
      }
      try {
        var results = await pagefind.search(query);
        if (!results || results.results.length === 0) {
          resultsEl.innerHTML = '<div class="search-no-results">No results for "<strong>' + escapeHtml(query) + '</strong>"</div>';
          return;
        }
        var html = '';
        var sliced = results.results.slice(0, 8);
        for (var i = 0; i < sliced.length; i++) {
          var data = await sliced[i].data();
          html += '<a href="' + data.url + '" class="search-result-item" onclick="window.closeSearch()">';
          html += '<div class="search-result-item__title">' + escapeHtml(data.meta?.title || '') + '</div>';
          if (data.excerpt) {
            html += '<div class="search-result-item__excerpt">' + data.excerpt + '</div>';
          }
          html += '</a>';
        }
        resultsEl.innerHTML = html;
      } catch(e) {
        resultsEl.innerHTML = '<div class="search-no-results">Search error. Please try again.</div>';
      }
    }

    input && input.addEventListener('input', function() {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(function() {
        doSearch(input.value);
      }, 200);
    });

    function escapeHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
  })();
</script>

<style is:global>
  .search-result-item {
    display: block;
    padding: 10px 4px;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background 100ms;
    border-radius: var(--radius-sm);
  }
  .search-result-item:last-child {
    border-bottom: none;
  }
  .search-result-item:hover {
    background: var(--nl-blue-light);
  }
  .search-result-item__title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 3px;
  }
  .search-result-item__excerpt {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  .search-result-item__excerpt mark {
    background: rgba(11, 92, 171, 0.15);
    color: var(--nl-blue);
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
