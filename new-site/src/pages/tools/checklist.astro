</style>

<script>
  const KEY = 'nl-checklist-v1';
  type State = { checked: Record<string, boolean>; notes: Record<string, string> };

  function load(): State {
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) {
        const s = JSON.parse(raw);
        return { checked: s.checked || {}, notes: s.notes || {} };
      }
    } catch {}
    return { checked: {}, notes: {} };
  }
  function save(s: State) {
    try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {}
  }

  const state = load();
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.ck-box'));
  const notes = Array.from(document.querySelectorAll<HTMLTextAreaElement>('.ck-note'));
  const status = document.getElementById('ck-status')!;

  function flash(msg: string) {
    status.textContent = msg;
    setTimeout(() => { if (status.textContent === msg) status.textContent = ''; }, 2500);
  }

  // Car-type / condition filters. An item is shown unless it is tagged for a category the
  // reader has filtered out. Counts, Copy and Print only cover the items shown.
  const FILTER_KEY = 'nl-checklist-filter-v1';
  let filter: { car: string; cond: string } = { car: 'all', cond: 'all' };
  try { filter = { ...filter, ...JSON.parse(localStorage.getItem(FILTER_KEY) || '{}') }; } catch {}
  const isShown = (li: HTMLElement) =>
    (filter.car === 'all' || li.dataset.car === 'all' || li.dataset.car === filter.car) &&
    (filter.cond !== 'new' || li.dataset.used !== 'yes');
  function applyFilter() {
    document.querySelectorAll<HTMLButtonElement>('.ck-filter button').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(filter[btn.dataset.filter as 'car' | 'cond'] === btn.dataset.value));
    });
    document.querySelectorAll<HTMLElement>('.ck-item').forEach((li) => { li.hidden = !isShown(li); });
    document.querySelectorAll<HTMLElement>('.ck-section').forEach((sec) => {
      sec.hidden = !sec.querySelector('.ck-item:not([hidden])');
    });
    refresh();
  }
  document.querySelectorAll<HTMLButtonElement>('.ck-filter button').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter[btn.dataset.filter as 'car' | 'cond'] = btn.dataset.value!;
      try { localStorage.setItem(FILTER_KEY, JSON.stringify(filter)); } catch {}
      applyFilter();
    });
  });

  function refresh() {
    let done = 0, shown = 0;
    for (const b of boxes) {
      const item = b.closest<HTMLElement>('.ck-item')!;
      item.classList.toggle('is-done', b.checked);
      if (item.hidden) continue;
      shown++;
      if (b.checked) done++;
    }
    document.getElementById('ck-done')!.textContent = String(done);
    document.getElementById('ck-total')!.textContent = String(shown);
    document.querySelectorAll<HTMLElement>('.ck-section').forEach((sec) => {
      const bs = Array.from(sec.querySelectorAll<HTMLInputElement>('.ck-box')).filter((b) => !b.closest<HTMLElement>('.ck-item')!.hidden);
      const n = bs.filter((b) => b.checked).length;
      const el = sec.querySelector<HTMLElement>('.ck-section-count');
      if (el) el.textContent = `${n}/${bs.length}`;
    });
    for (const t of notes) {
      const v = t.value.trim();
      t.closest('.ck-notes')!.classList.toggle('has-note', v !== '');
      const mirror = t.closest('.ck-item')!.querySelector<HTMLElement>('.ck-note-print');
      if (mirror) { mirror.textContent = v; mirror.hidden = v === ''; }
    }
  }

  // One-time coffee nudge after more than 10 ticks. Its own flag, separate from the
  // calculator's (nlc2-coffee-nudge-shown), so each tool asks at most once per browser.
  const NUDGE_KEY = 'nl-checklist-coffee-nudge-shown';
  const NUDGE_AFTER = 10;
  function track(name: string, params: Record<string, unknown> = {}) {
    try { (window as any).gtag?.('event', name, params); } catch {}
  }
  function nudgeAlreadyShown() {
    try { return localStorage.getItem(NUDGE_KEY) === '1'; } catch { return true; }
  }
  const nudge = document.getElementById('ck-coffee')!;
  function closeNudge(reason: 'dismissed' | 'support_clicked') {
    nudge.hidden = true;
    document.removeEventListener('keydown', onNudgeKey);
    if (reason === 'dismissed') track('coffee_nudge_dismissed', { source: 'final_checklist' });
  }
  function onNudgeKey(e: KeyboardEvent) { if (e.key === 'Escape') closeNudge('dismissed'); }
  nudge.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => closeNudge('dismissed')));
  document.getElementById('ck-coffee-go')!.addEventListener('click', () => {
    track('coffee_nudge_clicked', { source: 'final_checklist' });
    track('support_link_click', {
      link_label: 'buymeacoffee', link_url: 'https://buymeacoffee.com/changyang1230',
      page_path: location.pathname, page_title: document.title, source: 'coffee_nudge_checklist',
    });
    closeNudge('support_clicked');
  });
  function maybeNudge() {
    const ticked = boxes.filter((b) => b.checked).length;
    if (ticked <= NUDGE_AFTER || nudgeAlreadyShown()) return;
    try { localStorage.setItem(NUDGE_KEY, '1'); } catch {}
    nudge.hidden = false;
    document.addEventListener('keydown', onNudgeKey);
    requestAnimationFrame(() => (nudge.querySelector('.ck-coffee-card') as HTMLElement).focus());
    track('coffee_nudge_shown', { source: 'final_checklist', ticked });
  }

  for (const b of boxes) {
    b.checked = !!state.checked[b.dataset.id!];
    b.addEventListener('change', () => {
      state.checked[b.dataset.id!] = b.checked; save(state); refresh();
      if (b.checked) maybeNudge();
    });
  }
  for (const t of notes) {
    const v = state.notes[t.dataset.id!] || '';
    t.value = v;
    if (v.trim()) (t.closest('details') as HTMLDetailsElement).open = true;
    t.addEventListener('input', () => { state.notes[t.dataset.id!] = t.value; save(state); refresh(); });
  }
  applyFilter();

  function asText(): string {
    const lines: string[] = ['Novated lease final checklist: https://novatedlease.guide/tools/checklist/', ''];
    document.querySelectorAll<HTMLElement>('.ck-section:not([hidden])').forEach((sec) => {
      lines.push(sec.querySelector('h2')!.firstChild!.textContent!.trim());
      sec.querySelectorAll<HTMLElement>('.ck-item:not([hidden])').forEach((it) => {
        const id = it.dataset.id!;
        const title = it.querySelector('.ck-title')!.textContent!.trim();
        lines.push(`[${state.checked[id] ? 'x' : ' '}] ${title}`);
        const n = (state.notes[id] || '').trim();
        if (n) lines.push('    Note: ' + n.replace(/\n/g, '\n          '));
      });
      lines.push('');
    });
    return lines.join('\n');
  }

  function fillPrintHeader() {
    const d = new Date();
    document.getElementById('ck-print-date')!.textContent =
      'Printed ' + d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
    const carLabel: Record<string, string> = { all: 'All cars', ev: 'Electric', ice: 'Petrol / hybrid' };
    const condLabel: Record<string, string> = { all: 'new or used', new: 'New', used: 'Used' };
    const done = document.getElementById('ck-done')!.textContent, total = document.getElementById('ck-total')!.textContent;
    document.getElementById('ck-print-filter')!.textContent = `${carLabel[filter.car]} · ${condLabel[filter.cond]} · ${done} of ${total} checked`;
  }
  // Also covers the browser's own Print menu, not just our button.
  window.addEventListener('beforeprint', fillPrintHeader);

  document.getElementById('ck-print')!.addEventListener('click', () => {
    fillPrintHeader();
    notes.forEach((t) => { if (t.value.trim()) (t.closest('details') as HTMLDetailsElement).open = true; });
    window.print();
  });
  // navigator.clipboard needs a secure context (HTTPS) and is blocked in some in-app
  // browsers, so fall back to a hidden textarea + execCommand('copy').
  function legacyCopy(text: string): boolean {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.left = '0'; ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus(); ta.select(); ta.setSelectionRange(0, text.length);
    let ok = false;
    try { ok = document.execCommand('copy'); } catch {}
    document.body.removeChild(ta);
    return ok;
  }
  document.getElementById('ck-copy')!.addEventListener('click', async () => {
    const text = asText();
    try {
      if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(text); flash('Copied'); return; }
    } catch {}
    flash(legacyCopy(text) ? 'Copied' : 'Copy failed; try Print instead');
  });
  let armed = false;
  const resetBtn = document.getElementById('ck-reset') as HTMLButtonElement;
  resetBtn.addEventListener('click', () => {
    if (!armed) { armed = true; resetBtn.textContent = 'Click again to clear'; setTimeout(() => { armed = false; resetBtn.textContent = 'Clear all'; }, 3000); return; }
    armed = false; resetBtn.textContent = 'Clear all';
    state.checked = {}; state.notes = {}; save(state);
    boxes.forEach((b) => (b.checked = false));
    notes.forEach((t) => { t.value = ''; (t.closest('details') as HTMLDetailsElement).open = false; });
    refresh(); flash('Cleared');
  });
</script>
