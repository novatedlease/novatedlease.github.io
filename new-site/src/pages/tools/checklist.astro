    /* Always print in light mode: dark-theme colours would otherwise carry onto paper. */
    :global(:root), :global(:root[data-theme="dark"]) { color-scheme: light !important; --nl-blue: #0b5cab !important; --nl-blue-dark: #084a8c !important; --nl-blue-light: rgba(11, 92, 171, 0.08) !important; --nl-blue-mid: rgba(11, 92, 171, 0.18) !important; --nl-blue-solid: #0b5cab !important; --nl-blue-solid-hover: #084a8c !important; --color-bg: #ffffff !important; --color-bg-subtle: #f8f9fa !important; --color-surface: #ffffff !important; --color-surface-raised: #ffffff !important; --color-border: #e5e7eb !important; --color-border-mid: #d1d5db !important; --color-text: #111827 !important; --color-text-soft: #374151 !important; --color-text-muted: #6b7280 !important; --color-text-faint: #9ca3af !important; --adm-note-bg: #f9fafb !important; --adm-note-text: #374151 !important; --status-good: #047857 !important; }
