      display: block; margin: 6px 0 0 28px; padding: 2px 0 2px 8px;
      border-left: 3px solid #0b5cab; font-size: 11px; font-style: italic; color: #111827; white-space: pre-wrap;
    }
    .ck-note-print:not([hidden])::before {
      content: 'My note'; display: block; font-style: normal; font-weight: 700; font-size: 9.5px;
      text-transform: uppercase; letter-spacing: 0.04em; color: #0b5cab; margin-bottom: 1px;
