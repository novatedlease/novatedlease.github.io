---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/Article.astro';

export async function getStaticPaths() {
  // These IDs are handled by dedicated pages
  const skipIds = new Set([
    'tools/byo-employer-check',
  ]);

  const entries = await getCollection('docs');

  return entries
    .filter(entry => !skipIds.has(entry.id))
    .map(entry => {
      // Map "section/index" to "section" for URL
      let urlSlug = entry.id;
      if (urlSlug.endsWith('/index')) {
        urlSlug = urlSlug.slice(0, -6);
      }

      return {
        params: { slug: urlSlug || undefined },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const title = entry.data.title || headings.find(h => h.depth === 1)?.text || undefined;
const description = entry.data.description || undefined;

// Build canonical current path
const { slug } = Astro.params;
const currentPath = '/' + (slug || '') + '/';
const ogImage = `https://novatedlease.guide/og/${slug}.png`;
---

<ArticleLayout
  title={title}
  description={description}
  headings={headings}
  currentPath={currentPath}
  ogImage={ogImage}
  datePublished={entry.data.datePublished}
  dateModified={entry.data.dateModified}
  hide={entry.data.hide}
>
  <Content />
</ArticleLayout>
