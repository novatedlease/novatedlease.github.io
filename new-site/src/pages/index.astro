    <!-- Featured in -->
    <div class="featured-logo-strip">
      <div class="featured-logo-strip__label">As seen in</div>
      <div class="featured-logo-strip__items">
        <a class="featured-logo-strip__link" href="https://www.abc.net.au/news/2026-04-04/novated-leases-electric-vehicles-explainer/106527770" target="_blank" rel="noopener">
          <img class="featured-logo-strip__logo featured-logo-strip__logo--abc-news" src="/assets/images/featured/ABC_News_(Australia)_logo.svg.png" alt="ABC News" />
        </a>
        <a class="featured-logo-strip__link" href="https://passiveinvestingaustralia.com/why-most-novated-lease-advice-is-wrong/" target="_blank" rel="noopener">
          <img class="featured-logo-strip__logo featured-logo-strip__logo--pia" src="/assets/images/featured/pia.jpg" alt="Passive Investing Australia" />
        </a>
        <a class="featured-logo-strip__link" href="https://leasecheck.au" target="_blank" rel="noopener">
          <img class="featured-logo-strip__logo featured-logo-strip__logo--leasecheck" src="/assets/images/featured/leasecheck.png" alt="LeaseCheck" />
        </a>
        <a class="featured-logo-strip__link" href="https://leaseofmind.com.au" target="_blank" rel="noopener">
          <img class="featured-logo-strip__logo featured-logo-strip__logo--leaseofmind" src="/assets/images/featured/leaseofmind_og.jpg" alt="Lease of Mind" />
          <span class="featured-logo-strip__name">Lease of Mind</span>
        </a>
        <a class="featured-logo-strip__link" href="https://ccschecker.com.au/guides/ev-novated-lease-ccs-help-mls" target="_blank" rel="noopener">
          <img class="featured-logo-strip__logo featured-logo-strip__logo--ccschecker" src="/assets/images/featured/ccschecker.png" alt="CCS Checker AU" />
          <span class="featured-logo-strip__name">CCS Checker</span>
        </a>
      </div>
    </div>

    <!-- Testimonials — buy me a coffee last -->
    <div class="testimonials" id="testimonials">
      <div class="testimonials__title">What readers said</div>
      <div class="testimonials__scroll">
        <div class="testimonials__track" id="testimonials-track">
          {initialTestimonials.map(t => (
            <div class="testimonials__card">
              <div class="testimonials__quote">"{t.quote}"</div>
              <div class="testimonials__source">
                <img src={`https://www.google.com/s2/favicons?domain=${t.domain}&sz=16`} width="14" height="14" alt="" />
                <span>{t.who}{t.source && <> · <a href={t.source} target="_blank" rel="noopener">source</a></>}</span>
              </div>
            </div>
          ))}
        </div>
        <script type="application/json" id="testimonials-pool" set:html={JSON.stringify(testimonials)} />
        <div class="testimonials__fade" aria-hidden="true"></div>
      </div>
      <p class="testimonials__more"><a href="/about/what-readers-say/">See all {testimonials.length} reader comments, with sources →</a></p>
    </div>

  </div>
</FullPage>

<script is:inline>
  // Rotate testimonials: pick a random eight from the pool on each page load.
  (function () {
    try {
      var pool = JSON.parse(document.getElementById('testimonials-pool').textContent);
      var track = document.getElementById('testimonials-track');
      if (!pool || pool.length <= 8 || !track) return;
      for (var i = pool.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = pool[i]; pool[i] = pool[j]; pool[j] = t; }
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      track.innerHTML = pool.slice(0, 8).map(function (t) {
        var src = t.source ? ' · <a href="' + esc(t.source) + '" target="_blank" rel="noopener">source</a>' : '';
        return '<div class="testimonials__card"><div class="testimonials__quote">"' + esc(t.quote) + '"</div>' +
          '<div class="testimonials__source"><img src="https://www.google.com/s2/favicons?domain=' + esc(t.domain) + '&amp;sz=16" width="14" height="14" alt="" /><span>' +
          esc(t.who) + src + '</span></div></div>';
      }).join('');
    } catch (e) { /* keep the build-time four */ }
  })();

  function toggleBrowser() {
    var browser = document.getElementById('article-browser');
    var arrow = document.getElementById('browser-arrow');
    var body = document.getElementById('browser-body');
    var btn = browser.querySelector('.article-browser__toggle');
    var isOpen = browser.classList.toggle('open');
    arrow.textContent = isOpen ? '▾' : '▸';
    btn.setAttribute('aria-expanded', String(isOpen));
    body.setAttribute('aria-hidden', String(!isOpen));
  }
</script>
