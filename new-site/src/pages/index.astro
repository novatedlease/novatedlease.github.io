<script is:inline>
  function toggleBrowser() {
    var browser = document.getElementById('article-browser');
    var arrow = document.getElementById('browser-arrow');
    var body = document.getElementById('browser-body');
    var btn = browser.querySelector('.article-browser__toggle');
    var isOpen = browser.classList.toggle('open');
    arrow.textContent = isOpen ? '▾' : '▸';
    btn.setAttribute('aria-expanded', String(isOpen));
    body.setAttribute('aria-hidden', String(!isOpen));
  }
</script>
